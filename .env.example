# Copy this file to .env (or set these as real environment variables on
# your host) and fill in real values.

# Used to sign session cookies and email-verification tokens.
# Set this to a long random string in any real deployment.
SECRET_KEY=change-me-to-something-random

# --- Outgoing email (for account verification) ---
# Leave these blank to run in "dev mode": verification links are printed
# to the console, written to logs/emails.log, and shown directly on the
# check-your-email page, so you can still test signup/verify without
# real SMTP configured yet.
#
# Example values for Gmail: create an "App Password" in your Google
# account security settings (regular password won't work), then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   MAIL_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Tenor GIF search ---
# Get a free key at https://tenor.com/gifapi/documentation
# (it's issued through the Google Cloud console, same place as most
# Google API keys). Without this set, the GIF picker will show an
# error instead of results.
TENOR_API_KEY=
